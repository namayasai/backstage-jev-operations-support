{
  "version": "0.3.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/namayasai/backstage-jev-operations-support.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "config.d.ts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./alpha": {
      "types": "./dist/alpha.d.ts",
      "import": "./dist/alpha.mjs",
      "require": "./dist/alpha.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.mjs",
      "require": "./dist/search.js"
    },
    "./scaffolder": {
      "types": "./dist/scaffolder.d.ts",
      "import": "./dist/scaffolder.mjs",
      "require": "./dist/scaffolder.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "name": "@namayasai/backstage-plugin-jev-operations-support",
  "description": "Jev decision workbench and entity tab for Backstage",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "jev-operations-support",
    "pluginPackages": [
      "@namayasai/backstage-plugin-jev-operations-support",
      "@namayasai/backstage-plugin-jev-operations-support-backend",
      "@namayasai/backstage-plugin-jev-operations-support-common"
    ]
  },
  "scripts": {
    "build": "tsup src/index.ts src/alpha.tsx src/search.tsx src/scaffolder.tsx --format cjs,esm --dts --clean"
  },
  "dependencies": {
    "@namayasai/backstage-plugin-jev-operations-support-common": "0.3.0",
    "@backstage/core-plugin-api": "^1.12.10",
    "@backstage/frontend-plugin-api": "^0.18.1",
    "@backstage/plugin-catalog-react": "^3.2.3",
    "@backstage/catalog-model": "^1.10.1",
    "@backstage/core-components": "^0.18.14",
    "@material-ui/core": "^4.12.4",
    "@material-ui/lab": "4.0.0-alpha.61"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.30.2",
    "@backstage/plugin-search-react": "^1.11.8"
  },
  "peerDependenciesMeta": {
    "@backstage/plugin-search-react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@backstage/plugin-search-common": "^1.2.25"
  },
  "homepage": "https://github.com/namayasai/backstage-jev-operations-support#readme",
  "bugs": {
    "url": "https://github.com/namayasai/backstage-jev-operations-support/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "jev",
    "operations",
    "platform-engineering"
  ],
  "engines": {
    "node": ">=22"
  }
}
