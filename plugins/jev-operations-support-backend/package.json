{
  "version": "0.3.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/namayasai/backstage-jev-operations-support.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "config.d.ts"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "name": "@namayasai/backstage-plugin-jev-operations-support-backend",
  "description": "Authenticated Jev decision backend for Backstage",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "jev-operations-support"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format cjs --dts --clean"
  },
  "dependencies": {
    "@namayasai/backstage-plugin-jev-operations-support-common": "0.3.0",
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/plugin-permission-common": "^0.9.11",
    "express": "^4.21.2",
    "zod": "^3.24.0"
  },
  "configSchema": "config.d.ts",
  "homepage": "https://github.com/namayasai/backstage-jev-operations-support#readme",
  "bugs": {
    "url": "https://github.com/namayasai/backstage-jev-operations-support/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "jev",
    "operations",
    "platform-engineering"
  ],
  "engines": {
    "node": ">=22"
  }
}
