{
  "version": "0.3.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/namayasai/backstage-jev-operations-support.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "config.d.ts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "name": "@namayasai/backstage-plugin-jev-operations-support-tech-insights",
  "description": "Opt-in Jev fact retriever for Backstage Tech Insights",
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "tech-insights"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run src/*.test.ts"
  },
  "configSchema": "config.d.ts",
  "dependencies": {
    "@backstage-community/plugin-tech-insights-common": "^0.11.0",
    "@namayasai/backstage-plugin-jev-operations-support-backend": "0.3.0",
    "@namayasai/backstage-plugin-jev-operations-support-common": "0.3.0",
    "@backstage-community/plugin-tech-insights-node": "^2.9.0",
    "@backstage/backend-plugin-api": "^1.10.0",
    "@backstage/catalog-client": "^1.16.1",
    "@backstage/catalog-model": "^1.10.0",
    "@backstage/config": "^1.3.8",
    "@backstage/types": "^1.2.2",
    "luxon": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "homepage": "https://github.com/namayasai/backstage-jev-operations-support#readme",
  "bugs": {
    "url": "https://github.com/namayasai/backstage-jev-operations-support/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "tech-insights",
    "jev",
    "operations"
  ],
  "engines": {
    "node": ">=22"
  }
}
