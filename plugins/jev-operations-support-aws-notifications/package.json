{
  "version": "0.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/namayasai/backstage-jev-operations-support.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "config.d.ts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "name": "@namayasai/backstage-plugin-jev-operations-support-aws-notifications",
  "description": "Optional CloudWatch alarm notification module for Jev Operations Support",
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "jev-operations-support"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run src/*.test.ts"
  },
  "configSchema": "config.d.ts",
  "dependencies": {
    "@namayasai/backstage-plugin-jev-operations-support-backend": "0.2.0",
    "@namayasai/backstage-plugin-jev-operations-support-common": "0.2.0",
    "@backstage/backend-plugin-api": "^1.10.0",
    "@backstage/catalog-model": "^1.10.0",
    "@backstage/config": "^1.3.8",
    "@backstage/plugin-events-node": "^0.4.26",
    "@backstage/plugin-notifications-common": "^0.2.4",
    "@backstage/plugin-notifications-node": "^0.2.30",
    "@backstage/types": "^1.2.2",
    "luxon": "^3.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "homepage": "https://github.com/namayasai/backstage-jev-operations-support#readme",
  "bugs": {
    "url": "https://github.com/namayasai/backstage-jev-operations-support/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "aws",
    "cloudwatch",
    "notifications",
    "jev"
  ],
  "engines": {
    "node": ">=22"
  }
}
