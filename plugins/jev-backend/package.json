{
  "version": "0.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/namayasai/backstage-jev.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "config.d.ts"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "name": "@namayasai/backstage-plugin-jev-backend",
  "description": "Authenticated Jev decision backend for Backstage",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "jev"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  },
  "dependencies": {
    "@namayasai/backstage-plugin-jev-common": "0.1.0",
    "@backstage/backend-plugin-api": "^1.10.1",
    "@backstage/plugin-permission-common": "^0.9.11",
    "express": "^4.21.2",
    "zod": "^3.24.0"
  },
  "configSchema": "config.d.ts"
}
