{
  "name": "backstage-jev",
  "version": "0.1.0",
  "private": true,
  "description": "Six decision workflows for Backstage, powered by TypeSafe Jev",
  "license": "Apache-2.0",
  "workspaces": [
    "plugins/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite --host 127.0.0.1",
    "build:demo": "vite build",
    "check": "npm run typecheck && npm test && npm run build && npm run build:demo",
    "test:live": "tsx scripts/live-smoke.ts",
    "pack:plugins": "npm run build && mkdir -p dist/packages && npm pack --workspace plugins/jev-common --workspace plugins/jev-backend --workspace plugins/jev --pack-destination dist/packages"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
