{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@namayasai/backstage-plugin-jev-operations-support-common": [
        "plugins/jev-operations-support-common/src/index.ts"
      ],
      "@namayasai/backstage-plugin-jev-operations-support-backend/client": [
        "plugins/jev-operations-support-backend/src/client.ts"
      ]
    }
  },
  "include": [
    "plugins",
    "examples",
    "vite.config.ts",
    "vitest.config.ts",
    "scripts"
  ]
}
